# ==============================================================================
# NexServe — Root .gitignore
# Covers: Python (FastAPI), React / Vite, PostgreSQL, SQLite, Redis, OS & IDEs
# ==============================================================================

# ── Environment Variables & Secrets (NEVER COMMIT) ───────────────────────────
.env
.env.local
.env.*.local
*.env
.env.development
.env.test
.env.production
!.env.example
!.env.*.example

# ── Python / FastAPI ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
backend/venv/
backend/.venv/
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ── Testing & Code Quality ────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ── Node.js & React / Vite ───────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.tsbuildinfo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Databases & Storage ───────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
nexserve.db
backend/nexserve.db
dump.rdb

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── IDEs & Editors ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace

# ── Operating System ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
