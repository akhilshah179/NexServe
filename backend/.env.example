# ── App Configuration ────────────────────────────────
APP_NAME=NexServe
APP_VERSION=1.0.0
DEBUG=True

# ── Database ─────────────────────────────────────────
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Local SQLite fallback: sqlite:///./nexserve.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexserve

# ── Authentication & JWT Security ────────────────────
SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── Google OAuth 2.0 ─────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Redis Cache & Queue ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Razorpay Payment Gateway ─────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_CURRENCY=INR

# ── CORS Origins (JSON Array) ────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5174"]
